# Configuración del servidor y la base de datos
SECRET_KEY=
APP_ENV=development
APP_HOST=127.0.0.1
PORT=5000
MONGO_URI=mongodb://localhost:27017/adventurers_hub
FOUNDRY_DATA_PATH=./var/foundry/imports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
TRUST_PROXY_COUNT=0

# Docker Compose (genera contraseñas aleatorias hexadecimales; no subas .env)
MONGO_ROOT_USERNAME=adventurers_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=adventurers_app
MONGO_APP_PASSWORD=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
WEB_CONCURRENCY=2
VITE_FOUNDRY_URL=http://localhost:30000

# Llaves de APIs de inteligencia artificial (solo backend)
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
GOOGLE_API_KEY=
